@using MudBlazor

@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>Blazor: To Do</MudAppBar>

    <MudMainContent>
