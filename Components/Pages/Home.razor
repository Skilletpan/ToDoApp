@page "/"

@using ToDoApp.Enums;
@using ToDoApp.Models;

<PageTitle>Blazor: To Do</PageTitle>

<MudGrid>
    <!-- To Do Creator/Editor -->
    <MudItem xs="3">
        <EditForm Model="EditorDTO" OnValidSubmit="SubmitForm">
            <DataAnnotationsValidator />

            <MudCard Outlined>
                <!-- Header -->
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@(EditorDTO.ID == null ? "Create" : "Edit") To Do</MudText>
                    </CardHeaderContent>
                </MudCardHeader>

                <!-- Content -->
                <MudCardContent>
                    <!-- Name Input -->
                    <MudTextField @bind-Value="EditorDTO.Name" For="@(() => EditorDTO.Name)" Label="Name" MaxLength="30"
                                  Variant="Variant.Outlined" Class="mb-4" />

                    <!-- Status Input -->
                    <MudSelect @bind-Value="EditorDTO.Status" For="@(() => EditorDTO.Status)" Label="Status"
                               Variant="Variant.Outlined">
                        @foreach (TodoStatus status in Enum.GetValues(typeof(TodoStatus)))
                        {
                            <MudSelectItem Value="@status">
                                @(status == TodoStatus.InProgress ? "In Progress" : status)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudCardContent>

                <!-- Actions -->
                <MudCardActions>
                    <!-- Reset Form -->
                    <MudButton ButtonType="ButtonType.Reset" Color="Color.Error" Class="mr-2" @onclick="ResetForm">
                        @(EditorDTO.ID == null ? "Reset" : "Cancel")
                    </MudButton>

                    <!-- Submit Form -->
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                        @(EditorDTO.ID == null ? "Add" : "Update")
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </EditForm>
    </MudItem>

    <!-- To Do Items -->
    <MudItem xs="9">
        <MudTable Items="@TodoItems" Filter="Filters.CheckItem" Dense FixedHeader Outlined>
            <!-- Toolbar -->
            <ToolBarContent>
                <MudText Typo="Typo.h6">My To Dos</MudText>

                <MudSpacer />

                <!-- Name Search -->
                <MudTextField @bind-Value="Filters.Search" Placeholder="Search…" Clearable Immediate
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />

                <!-- Status Filter -->
                <MudToggleGroup @bind-Values="Filters.Status" T="TodoStatus"
                                SelectionMode="SelectionMode.MultiSelection" Class="ml-4">
                    @foreach (TodoStatus status in Enum.GetValues(typeof(TodoStatus)))
                    {
                        <MudToggleItem Value="@status">
                            @status
                        </MudToggleItem>
                    }
                </MudToggleGroup>
            </ToolBarContent>

            <!-- Column Headers -->
            <HeaderContent>
                <!-- Sortable Columns -->
                @foreach (var header in ColumnHeaders)
                {
                    <MudTh>
                        <MudTableSortLabel SortBy="header.Value">@header.Key</MudTableSortLabel>
                    </MudTh>
                }

                <!-- Actions Column -->
                <MudTh></MudTh>
            </HeaderContent>

            <!-- To Do Item Rows -->
            <RowTemplate>
                <!-- Name -->
                <MudTd DataLabel="Name">
                    <!-- Name -->
                    <MudText Typo="Typo.subtitle2">@context.Name</MudText>

                    <!-- ID -->
                    <MudText Typo="Typo.caption">
                        ID: <MudText Typo="Typo.inherit" Color="Color.Info">@context.ID</MudText>
                    </MudText>
                </MudTd>

                <!-- Status -->
                <MudTd DataLabel="Status">
                    <!-- Status Text -->
                    @context.Status

                    <!-- Progress Button -->
                    @if (@context.Status < TodoStatus.Done)
                    {
                        <MudTooltip Text="@($"Move to {context.Status + 1}")">
                            <MudIconButton Icon="@Icons.Material.Filled.FastForward" Size="Size.Small" Class="ml-2"
                                           @onclick="_ => ProgressTodo(context)" />
                        </MudTooltip>
                    }
                </MudTd>

                <!-- Created -->
                <MudTd DataLabel="Created">@context.Created.ToLocalTime().ToString("dd.MM.yyyy, HH:mm")</MudTd>

                <!-- Changed -->
                <MudTd DataLabel="Changed">@context.Changed.ToLocalTime().ToString("dd.MM.yyyy, HH:mm")</MudTd>

                <!-- Actions -->
                <MudTd DataLabel="Actions" Style="text-align: right;">
                    <!-- Edit Button -->
                    <MudTooltip Text="Edit">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       @onclick="_ => EditorDTO = context.ToDTO()" />
                    </MudTooltip>
                    
                    <!-- Delete Button -->
                    <MudTooltip Text="Delete">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       @onclick="_ => DeleteTodo(context)" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>

            <!-- Table End Row -->
            <FooterContent>
                <MudTd colspan="5">
                    <MudText Align="Align.Center" Typo="Typo.body2">End of List</MudText>
                </MudTd>
            </FooterContent>
        </MudTable>
    </MudItem>
</MudGrid>
