@page "/"
@rendermode InteractiveServer

@using ToDoApp.Enums;

<PageTitle>Blazor: To Do</PageTitle>

<div class="container-fluid">
    <h1>Blazor: To Do</h1>

    <hr />

    <div class="row">
        <!-- To Do Editor -->
        <div class="col-sm-3">
            <div class="card">
                <!-- Card Header -->
                <div class="card-header">
                    @(EditorDTO.ID == null ? "Add To Do" : "Edit To Do")
                </div>

                <!-- Card Body / Todo Editor -->
                <EditForm Model="EditorDTO" class="card-body" autocomplete="off" OnValidSubmit="SubmitForm">
                    <DataAnnotationsValidator />

                    <!-- ID Display -->
                    @if (EditorDTO.ID != null)
                    {
                        <div class="input-group mb-2">
                            <span class="input-group-text">ID</span>
                            <input class="form-control" disabled value="@EditorDTO.ID" />
                        </div>
                    }

                    <!-- Name Input -->
                    <div class="input-group mb-2">
                        <span class="input-group-text">Name</span>
                        <InputText class="form-control" @bind-Value="EditorDTO.Name" />
                    </div>
                    <ValidationMessage For="@(() => EditorDTO.Name)" class="mb-2 text-danger" />

                    <!-- Status Select -->
                    <div class="input-group mb-3">
                        <span class="input-group-text">Status</span>
                        <InputSelect class="form-control" @bind-Value="EditorDTO.Status">
                            @foreach (var status in Enum.GetNames(typeof(TodoStatus)))
                            {
                                <option>@status</option>
                            }
                        </InputSelect>
                    </div>
                    <ValidationMessage For="@(() => EditorDTO.Status)" class="mb-2 text-danger" />

                    <!-- Actions -->
                    <div class="row">
                        <!-- Reset Form -->
                        <div class="col">
                            <button class="form-control btn btn-outline-danger" type="reset" @onclick="ResetForm">
                                @(EditorDTO.ID == null ? "Reset" : "Cancel")
                            </button>
                        </div>

                        <!-- Submit Form -->
                        <div class="col">
                            <button class="form-control btn btn-primary" type="submit">
                                @(EditorDTO.ID == null ? "Add" : "Update")
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="col-sm-9">
            <!-- Todo Filters -->
            <div class="input-group mb-3">
                <!-- Name Search -->
                <span class="input-group-text">Search</span>
                <input class="form-control" placeholder="Name…" @bind="SearchName" @bind:event="oninput" />
            </div>

            <!-- Todos Table -->
            <table class="table table-bordered table-striped">
                <!-- Column Headers -->
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Changed</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <!-- Body with Todo Items -->
                <tbody>
                    @foreach (var todoItem in FilteredTodoItems)
                    {
                        <!-- Todo Item Row -->
                        <tr class="align-middle">
                            <td>@todoItem.ID</td>
                            <td>@todoItem.Name</td>
                            <td>@todoItem.Status</td>
                            <td>@todoItem.Created.ToLocalTime().ToString("dd.MM.yyyy, hh:mm")</td>
                            <td>@todoItem.Changed.ToLocalTime().ToString("dd.MM.yyyy, hh:mm")</td>
                            <td>
                                <!-- Progress Todo Item (move one stage forward) -->
                                @if (todoItem.Status < TodoStatus.Done)
                                {
                                    <button class="btn btn-sm btn-secondary me-2" @onclick="() => ProgressTodo(todoItem)">
                                        Progress
                                    </button>
                                }

                                <!-- Edit Todo Item -->
                                <button class="btn btn-sm btn-primary me-2" @onclick="() => EditorDTO = todoItem.ToDTO()">
                                    Edit
                                </button>

                                <!-- Delete Todo Item -->
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteTodo(todoItem)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
