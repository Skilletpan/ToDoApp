@page "/"
@rendermode InteractiveServer

<PageTitle>Blazor: To Do</PageTitle>

<h1>Blazor: To Do</h1>

<!-- Todos Table -->
<table class="table table-bordered table-striped">
    <!-- Column Headers -->
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Status</th>
            <th>Created</th>
            <th>Changed</th>
        </tr>
    </thead>

    <!-- Body with Todo Items -->
    <tbody>
        @foreach (var todoItem in todoItems)
        {
            <!-- Todo Item Row -->
            <tr>
                <td>@todoItem.ID</td>
                <td>@todoItem.Name</td>
                <td>@todoItem.Status</td>
                <td>@todoItem.Created.ToLocalTime().ToString("dd.MM.yyyy, hh:mm")</td>
                <td>@todoItem.Changed.ToLocalTime().ToString("dd.MM.yyyy, hh:mm")</td>
            </tr>
        }
    </tbody>
</table>
